# Agent API base (no trailing slash)

EARNFI_AGENT_API_BASE=
EARNFI_AGENT_API_HOST=app.earnfi.fun

# Optional: default for tools that need agent_token (from POST /register)
EARNFI_AGENT_TOKEN=

# Server
MCP_PORT=
MCP_BIND_HOST=

# When clients connect with Host: mcp.yourdomain.com, list it (comma-separated)
MCP_ALLOWED_HOSTS=

# In-memory event store for resumable MCP streams (single process). Set 0 to disable
MCP_ENABLE_EVENT_STORE=1

# Optional: require Authorization: Bearer <token> on /mcp (not /healthz)
MCP_BEARER_TOKEN=
