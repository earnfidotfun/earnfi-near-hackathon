{
  "$schema": "EarnFi public hackathon export manifest (Strategy B+ — no WordPress server source)",
  "repoName": "earnfi-near-hackathon",
  "includeGlobs": [
    "docs/hackathon/**",
    "examples/hackathon/**",
    "packages/agent-client/**",
    "packages/earnfi-mcp-server/**",
    "public/hackathon-agent.html",
    "scripts/hackathon/**",
    ".github/workflows/**"
  ],
  "includeFiles": [],
  "excludeGlobs": [
    "**/node_modules/**",
    "**/.env",
    "**/.env.*",
    "**/dist/**",
    "**/.git/**",
    "**/wp-admin/**",
    "**/wp-includes/**",
    "**/wp-config*.php",
    "**/*.sql",
    "**/*.sql.gz",
    "**/secrets/**",
    "**/.agents/**",
    "**/*.php",
    "packages/agent-client/node_modules/**",
    "packages/earnfi-mcp-server/node_modules/**"
  ],
  "excludeFiles": [
    "scripts/hackathon/export-manifest-php-slice.json"
  ],
  "contractCopies": [
    {
      "from": "includes/data/earnfi-skill.md",
      "to": "contracts/skill.md"
    },
    {
      "from": "includes/data/openapi-x402.json",
      "to": "contracts/openapi-x402.json"
    },
    {
      "from": "includes/data/mcp-server-card.json",
      "to": "contracts/mcp-server-card.json"
    },
    {
      "from": "includes/data/work-console.md",
      "to": "contracts/work-api.md"
    },
    {
      "from": "includes/data/llms.txt",
      "to": "contracts/llms.txt"
    }
  ],
  "sanitizePatterns": [
    {
      "name": "env-assignment",
      "regex": "(define\\s*\\(\\s*['\"][A-Z0-9_]+['\"]\\s*,\\s*['\"])([^'\"]{8,})(['\"])",
      "replace": "$1[REDACTED]$3"
    },
    {
      "name": "private-key-block",
      "regex": "-----BEGIN (?:RSA |EC )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC )?PRIVATE KEY-----",
      "replace": "-----BEGIN PRIVATE KEY-----\n[REDACTED]\n-----END PRIVATE KEY-----"
    },
    {
      "name": "bearer-token",
      "regex": "Bearer\\s+[A-Za-z0-9._-]{20,}",
      "replace": "Bearer [REDACTED]"
    },
    {
      "name": "wordpress-word",
      "regex": "\\bWordPress\\b",
      "replace": "hosted EarnFi runtime"
    },
    {
      "name": "growl-settings",
      "regex": "growl_settings",
      "replace": "earnfi_runtime_config"
    }
  ],
  "topicCommits": [
    {
      "paths": ["docs/hackathon", "contracts", "examples/hackathon"],
      "message": "docs: NEAR hackathon — Work & Money layer, Solvador, hosted runtime"
    },
    {
      "paths": ["packages/agent-client"],
      "message": "feat(sdk): @earn-fi/agent-client multichain x402 and work commissioning"
    },
    {
      "paths": ["packages/earnfi-mcp-server"],
      "message": "feat(mcp): EarnFi MCP tools for Agent API and Work flows"
    },
    {
      "paths": ["public/hackathon-agent.html", "scripts/hackathon"],
      "message": "chore: demo console, export tooling, live integration examples"
    }
  ]
}